{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist"
  },
  "include": [
    "packages/**/*",
    "apps/api/**/*",
    "apps/web/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "apps/windows-agent"
  ]
}
